# Servidor
PORT=3000
# Origen(es) permitidos para CORS. "*" o lista separada por comas: https://miapp.com,https://www.miapp.com
CLIENT_URL=*

# Base de datos (local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=almacen_multimarca

# SSL para MySQL gestionado en la nube (Railway/Render). Ponlo en true si tu proveedor lo exige.
DB_SSL=false

# Seguridad
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria

# Alternativa: una sola cadena de conexión (tiene prioridad sobre las variables individuales).
# Railway la inyecta como MYSQL_URL automáticamente; también puedes usar DATABASE_URL.
# DATABASE_URL=mysql://usuario:password@host:puerto/nombre_db
