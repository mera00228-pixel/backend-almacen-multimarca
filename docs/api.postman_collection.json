{
  "info": {
    "name": "Almacén Multimarca API",
    "description": "Colección de las rutas principales del backend (auth, productos y salud).\n\nVARIABLES DE COLECCIÓN:\n- baseUrl: URL base del backend. Local: http://localhost:3000. Railway: https://TU-DOMINIO.up.railway.app\n- token: se llena automáticamente al ejecutar el Login (2h de validez).\n- productoId: se llena automáticamente al crear un producto.\n\nIMPORTAR: Postman (Import > File), Insomnia (Import > From File) o Thunder Client.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "productoId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Salud",
      "item": [
        {
          "name": "GET /health (liveness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Responde 200 siempre que el proceso esté vivo. No depende de la BD."
          },
          "response": []
        },
        {
          "name": "GET /health/ready (readiness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": ["{{baseUrl}}"],
              "path": ["health", "ready"]
            },
            "description": "200 si la BD responde; 503 si está caída."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "POST /api/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "if (data.token) {",
                  "    pm.collectionVariables.set('token', data.token);",
                  "    console.log('Token guardado en {{token}}');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"admin\",\n  \"contraseña\": \"1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            },
            "description": "Devuelve { token }. El token se guarda automáticamente en la variable de colección {{token}}."
          },
          "response": []
        },
        {
          "name": "POST /api/register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"nuevo_usuario\",\n  \"contraseña\": \"secreto123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "register"]
            },
            "description": "Crea un usuario. La contraseña debe tener al menos 6 caracteres."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "GET /api/productos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"]
            },
            "description": "Lista todos los productos ordenados por id DESC."
          },
          "response": []
        },
        {
          "name": "GET /api/productos/:id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{productoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "{{productoId}}"]
            },
            "description": "Obtiene un producto por id. 404 si no existe."
          },
          "response": []
        },
        {
          "name": "POST /api/productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Creado (201)', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "if (data.id) {",
                  "    pm.collectionVariables.set('productoId', data.id);",
                  "    console.log('productoId guardado:', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo_barras\": \"7501234567890\",\n  \"nombre\": \"Producto de prueba\",\n  \"descripcion\": \"Creado desde Postman\",\n  \"imagen_url\": \"https://cdn.ejemplo.com/fotos/producto.jpg\",\n  \"precio_compra\": 10.5,\n  \"precio_venta\": 15.99,\n  \"stock\": 20,\n  \"stock_minimo\": 5,\n  \"marca_id\": 1,\n  \"categoria_id\": 1,\n  \"estado\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"]
            },
            "description": "Crea un producto y guarda el id devuelto en {{productoId}}.\nObligatorios: codigo_barras, nombre, precio_compra, precio_venta, stock.\nOpcionales: descripcion, stock_minimo (5), marca_id, categoria_id, estado (1).\nErrores: 409 codigo_barras duplicado, 400 marca_id/categoria_id inexistentes."
          },
          "response": []
        },
        {
          "name": "PUT /api/productos/:id",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo_barras\": \"7501234567890\",\n  \"nombre\": \"Producto actualizado\",\n  \"descripcion\": \"Actualizado desde Postman\",\n  \"imagen_url\": \"https://cdn.ejemplo.com/fotos/producto-actualizado.jpg\",\n  \"precio_compra\": 11,\n  \"precio_venta\": 16.5,\n  \"stock\": 25,\n  \"stock_minimo\": 5,\n  \"marca_id\": 1,\n  \"categoria_id\": 1,\n  \"estado\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{productoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "{{productoId}}"]
            },
            "description": "Actualiza un producto existente. 404 si no existe."
          },
          "response": []
        },
        {
          "name": "DELETE /api/productos/:id",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{productoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos", "{{productoId}}"]
            },
            "description": "Elimina un producto. 404 si no existe."
          },
          "response": []
        }
      ]
    }
  ]
}
